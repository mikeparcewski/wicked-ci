#!/usr/bin/env python3
"""e2e: the wicked platform certification catalog tool (stdlib only).

    e2e validate [--report RUN_DIR] [--baseline FILE] [--surfaces DIR] [--out DIR] [-v]
    e2e select EXPR | --profile NAME
    e2e surfaces (--src DIR | --clone {pinned,main}) [--repos LIST] [--crew-npm VERSION|latest]
                 [--out DIR] [--write-pins]
    e2e drift --against DIR [--out DIR]
    e2e baseline [--write] [--path FILE]
    e2e run (--select EXPR | --profile NAME) --out DIR [--target fixture|live] [--plan-only] ...
    e2e report RUN_DIR
    e2e resolve "REQUEST" [--run-dir RUN_DIR] [--json]
    e2e evidence RUN_DIR CAP_ID [--json] [--no-vault-cli]

Windows: run it as `python e2e/bin/e2e ...`.
"""
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

from e2ecat.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
